# Massive flat files (S3-compatible access keys)
MASSIVE_S3_KEY_ID=your-massive-flat-file-key-id
MASSIVE_S3_SECRET=your-massive-flat-file-secret

# Massive REST API key
MASSIVE_API_KEY=your-massive-api-key

# AWS (destination bucket)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Snowflake (key-pair login)
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=DAGSTER_SVC
SNOWFLAKE_PRIVATE_KEY_FILE=snowflake_key.p8

# Local folder the trading dashboard writes exports to
DASH_EXPORTS_FOLDER=C:/path/to/exports
